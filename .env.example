# ============================================
# CONFIGURAÇÕES DO SERVIDOR
# ============================================
PORT=3100

# ============================================
# WHATSAPP CLOUD API (Meta)
# ============================================
# Token de verificação do webhook (você define este valor)
VERIFY_TOKEN=meu_token_secreto_123

# Token de acesso permanente gerado no Meta Developer Dashboard (app do MARINASC)
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxx

# ID do número do bot (+244 955 705 188), em WhatsApp > API Setup
PHONE_NUMBER_ID=1234567890123456

# Versão da Graph API (opcional)
GRAPH_API_VERSION=v22.0

# ============================================
# IA (conversa natural e áudios)
# ============================================
# Groq: gratuito. Chave em https://console.groq.com/keys (começa por gsk_)
# Usa o gpt-oss-120b para conversar e o Whisper large v3 para os áudios.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxx

# Alternativa paga: OpenAI (só é usada se GROQ_API_KEY estiver vazia)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Opcional: trocar os modelos (ex.: AI_MODEL=qwen/qwen3.8-27b no Groq)
# AI_MODEL=
# AI_TRANSCRIBE_MODEL=

# ============================================
# ADMIN
# ============================================
# Números que podem usar /stats, /promo, /pausa e /retomar (com 244, separados por vírgula)
ADMIN_NUMBERS=244946397096

# ============================================
# CONFIGURAÇÕES OPCIONAIS
# ============================================
# Idioma padrão: pt (Português) ou en (Inglês)
DEFAULT_LANGUAGE=pt

# Modo debug: true ou false
DEBUG=false
