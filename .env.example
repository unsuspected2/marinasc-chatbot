# ============================================
# CONFIGURAÇÕES DO SERVIDOR
# ============================================
PORT=3000

# ============================================
# WHATSAPP CLOUD API (Meta)
# ============================================
# Token de verificação do webhook (você define este valor)
VERIFY_TOKEN=meu_token_secreto_123

# Token de acesso permanente gerado no Meta Developer Dashboard
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxx

# ID do número de telefone do WhatsApp Business
PHONE_NUMBER_ID=1234567890123456

# ============================================
# OPENAI API (Fallback de IA)
# ============================================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxx

# ============================================
# CONFIGURAÇÕES OPCIONAIS
# ============================================
# Idioma padrão: pt (Português) ou en (Inglês)
DEFAULT_LANGUAGE=pt

# Modo debug: true ou false
DEBUG=false
